# Where the Vite dev server proxies /api requests (the Laravel app)
VITE_BACKEND_URL=http://127.0.0.1:8000

# For a production build served separately from Laravel, set the full API base URL
# VITE_API_URL=https://api.medlink.et/api

# Maps are FREE by default (OpenStreetMap via Leaflet, no key, no billing).
# Optional: Google Maps instead, for "Pharmacies near me" and other maps. A browser key with the
# Maps JavaScript API enabled, restricted to your site's domains (HTTP referrers).
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud for custom map styling (DEMO_MAP_ID is used otherwise)
# VITE_GOOGLE_MAPS_MAP_ID=
